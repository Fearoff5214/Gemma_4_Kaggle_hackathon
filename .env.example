# Copy to .env and fill in ONE option. .env is git-ignored; never commit it.
#
# The Kaggle CLI does not read .env by itself. From the repo root, activate the
# venv (PowerShell: .venv\Scripts\Activate.ps1, Git Bash: source .venv/Scripts/activate),
# then load .env per command:
#   python -m dotenv run -- kaggle competitions files gemma-4-developer-agent
# (dotenv run needs a bare command name on Windows; a relative path like
# .venv/Scripts/kaggle fails with "Command not found".)
# Leave unused options commented out: an empty KAGGLE_USERNAME or KAGGLE_KEY
# would override the values in ~/.kaggle/kaggle.json.

# Option 1 (recommended): an API token from https://www.kaggle.com/settings/api
# ("Generate New Token"). The CLI tries this first.
KAGGLE_API_TOKEN=

# Option 2: a legacy API key (the username and key inside kaggle.json).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
